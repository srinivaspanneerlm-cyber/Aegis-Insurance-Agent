# ─────────────────────────────────────────────────────────────
# Aegis AI Backend — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Runtime
PORT=5000
NODE_ENV=development                 # development | production

# HTTP keep-alive timeouts (ms). Keep KEEPALIVE_TIMEOUT_MS ABOVE your upstream
# proxy/load-balancer idle timeout (nginx/ALB commonly 60s) so Node never closes
# a socket the proxy is about to reuse — the classic intermittent-502 race. Keep
# HEADERS_TIMEOUT_MS above KEEPALIVE_TIMEOUT_MS or requests can be cut short.
KEEPALIVE_TIMEOUT_MS=61000
HEADERS_TIMEOUT_MS=65000

# Database (use PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Auth — JWT
# JWT_SECRET MUST be a long, random, high-entropy string (>= 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_64_char_random_secret"
JWT_EXPIRES_IN="30d"

# Access-token lifetime. Kept short: the client refreshes silently via
# POST /api/v1/auth/refresh, so the customer never notices, while a stolen
# access token stops being useful within minutes. The refresh token is the
# long-lived, rotating, revocable credential — lengthen that one, not this one.
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"

# CORS — comma-separated list of allowed browser origins (no trailing slash).
# In production this MUST be set to your real frontend origin(s).
#
# This is also the CSRF allowlist: a state-changing request carrying a session
# cookie is refused unless its Origin appears here (see
# `middleware/csrf.middleware.ts`). List every origin the portal is genuinely
# served from — miss one and signed-in customers get a 403 on every save;
# add one loosely and you have widened the forgery surface.
CLIENT_URL="http://localhost:3000"

# Auth cookie Secure flag. "false" for local HTTP; "true" when served over HTTPS.
COOKIE_SECURE="false"

# Cache / scale-out store. Leave BLANK to use the in-process cache (fine for
# dev and single-node). Set it to run the shared cache on Redis so multiple
# app instances share one cache; the app degrades to no-cache if Redis is down.
#   REDIS_URL="redis://localhost:6379"
REDIS_URL=""

# Downstream AI microservice
AI_SERVICE_URL="http://localhost:8000/api/ai"

# Shared secret used to authenticate backend -> AI microservice calls.
# When set, the AI service will reject requests without a matching key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_INTERNAL_API_KEY="CHANGE_ME_shared_internal_service_key"

# Google Sign-In — OAuth 2.0 Web client ID (from Google Cloud Console).
# Public value (also set as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend); it is
# NOT a secret and needs no client secret. When unset, the /auth/google route
# fails closed and only email/password login is available.
GOOGLE_CLIENT_ID=""

# Uploads. Aegis accepts PDF, DOCX, PNG, JPG, HEIC, WEBP, MP4 and MOV — customers
# photograph paperwork on phones and send motor walkaround videos, so the cap has
# to fit a real photo. The declared type is never trusted: every file's magic
# bytes are read and must agree with its extension (src/utils/fileTypes.ts).
# Lower these if disk or bandwidth is tight; they are per-file and per-request.
UPLOAD_MAX_BYTES="52428800"
UPLOAD_MAX_FILES="5"

# Startup convenience: force-release the port if occupied (kills the PID).
# Left disabled by default because it uses `kill -9`. Set to "true" only in
# trusted local dev environments.
AUTO_RELEASE_PORT="false"

# Express "trust proxy" — how many front proxies/load balancers sit in front of
# the app. "false" when directly exposed; "1" behind a single LB/CDN. Governs
# how the rate limiter derives the client IP. Never set "true" (IP spoofing).
TRUST_PROXY="false"

# ── Outbound mail ────────────────────────────────────────────────────────────
# Where a person lands when they click a verification or password-reset link.
# This is the identity app, not this API — a backend URL would hand them a JSON
# 404 instead of a password form.
IDENTITY_APP_URL=http://localhost:3105

# Delivery seam for verification and reset mail. The mailer POSTs
# { to, kind, subject, actionUrl, expiresAt } as JSON to this URL, so any
# transactional provider reachable over HTTP works and none is hardcoded:
# a provider's own inbound hook, a relay you host, or an automation endpoint.
#
# Leave it unset in development and the link is written to the server log so the
# flow stays testable end to end. Leave it unset in PRODUCTION and no mail is
# sent and the token is deliberately withheld from the log — nobody will be able
# to reset a password. The server warns about this at startup.
#
# Never put a provider API key here; the key belongs to the endpoint you point at.
AUTH_MAIL_WEBHOOK_URL=

# Shared secret sent as X-Webhook-Secret with every mail-webhook call, so the
# relay can prove the request came from this platform. Optional for a relay
# bound to localhost; required for anything reachable beyond it — otherwise
# whoever finds the URL can send mail from your domain. Generate one with:
#   openssl rand -base64 32
AUTH_MAIL_WEBHOOK_SECRET=

# ── The bundled relay (services/notification-service) ────────────────────────
# Point AUTH_MAIL_WEBHOOK_URL at it and set these two in ITS environment, not
# here — the provider key belongs to the service that talks to the provider:
#   RESEND_API_KEY=re_...        from resend.com, never committed
#   MAIL_FROM="Aegis AI <noreply@your-verified-domain>"
# Then: AUTH_MAIL_WEBHOOK_URL=http://localhost:4002/auth-mail
