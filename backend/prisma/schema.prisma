// ─────────────────────────────────────────────────────────────────────────────
// Aegis AI — Enterprise Insurance Platform : Prisma schema
//
// Design rules (enforced):
//   • Additive & backward-compatible — no existing field is renamed or dropped,
//     so the Prisma Client API used across the backend keeps working unchanged.
//   • Every model carries audit + soft-delete + optimistic-locking fields.
//   • Indexes cover every real query path (owner + time, status + time, FKs).
//   • Provider-portable MODELS: this schema validates on both SQLite (dev) and
//     PostgreSQL (prod). The `provider` below is a literal (Prisma can't read it
//     from env), so switch it with `npm run db:provider postgresql` at deploy;
//     migration SQL is dialect-specific and is regenerated per DB — see DATABASE.md.
//   • SQLite has no native enums; string fields document their allowed values.
//
// NOTE on soft delete: `deletedAt` is present on all core models but is NOT yet
// enforced in queries (that would change response behaviour). Enforcement is a
// deliberate, separately-reviewed follow-up so this change stays behaviour-safe.
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Core identity ────────────────────────────────────────────────────────────

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  // ── Identity: realm and role ───────────────────────────────────────────────
  // Two fields because they answer two different questions, and conflating them
  // is what produced three disagreeing role vocabularies in this codebase.
  //
  //   `realm` decides which portal a person enters. It is a property of who they
  //   are to the business — a customer, a member of branch staff, an enterprise
  //   administrator, an Aegis operator — and it changes almost never.
  //
  //   `role` is a named bundle of capabilities *within* a realm. It changes when
  //   someone's job changes, and new ones are expected.
  //
  // Neither is ever branched on directly. Authorisation asks for a permission;
  // the bundles live in `src/auth/permissions.ts` where a typo is a compile
  // error rather than a silently missing capability. See `src/auth/realms.ts`.
  realm String @default("CUSTOMER") // CUSTOMER | EMPLOYEE | ENTERPRISE | PLATFORM
  role  String @default("CUSTOMER") // CUSTOMER | EMPLOYEE | ENTERPRISE_ADMIN | PLATFORM_ADMIN | …

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  version   Int       @default(1) // optimistic-locking token

  // ── Identity provider ──────────────────────────────────────────────────────
  // DEPRECATED: superseded by `LinkedIdentity`. One column can only ever hold
  // one provider, so a second way in (Microsoft, Apple, an insurer's OIDC, an
  // Aadhaar broker) would have meant a second column and a second code path.
  // Existing values were copied into LinkedIdentity by the migration that added
  // it; the column is kept because this schema never drops a field, but nothing
  // reads or writes it any more.
  googleId    String?   @unique
  image       String? // profile picture URL from the provider
  lastLoginAt DateTime?

  // ── Credential state ───────────────────────────────────────────────────────
  // Null means the address has never been proved. Whether that *blocks* sign-in
  // is a policy decision per realm, not a property of the column — see
  // `realms.ts`. A timestamp rather than a boolean because "when" is free to
  // store and answers questions a flag cannot.
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?

  // Lockout. Counted rather than inferred, so the threshold is auditable and a
  // successful sign-in can reset it in one write.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Future MFA. Present now so enrolling a factor is a data change rather than
  // a migration on a table that by then holds every account on the platform.
  mfaEnrolledAt DateTime?
  mfaMethod     String? // totp | webauthn | sms

  // ── Onboarding ─────────────────────────────────────────────────────────────
  // `onboardedAt` is the first-login gate: null means the conversational
  // onboarding has not been completed, so the user is sent there instead of the
  // dashboard. A timestamp rather than a boolean — "when" is free to store and
  // answers questions a flag cannot.
  onboardedAt        DateTime?
  preferredLanguage  String? // en | ta | taEn
  // JSON array of interest ids. SQLite has no list type and this schema targets
  // both SQLite (dev) and Postgres (prod), so it is stored the same way
  // AuditLog.metadata is.
  insuranceInterests String?

  // Relations (all nullable on the owned side to preserve legacy rows)
  chats              Chat[]
  uploadedDocuments  UploadedDocument[]
  insuranceProfile   InsuranceProfile?
  conversations      ConversationParticipant[]
  mentions           Mention[]
  notificationPrefs  NotificationPreference?
  announcementReads  AnnouncementRead[]
  intelligenceRuns   IntelligenceRun[]
  leads              Lead[]                    @relation("AssignedLeads")
  sessions           Session[]
  recommendations    RecommendationHistory[]
  notifications      Notification[]
  auditLogs          AuditLog[]                @relation("ActorAuditLogs")
  refreshTokens      RefreshToken[]
  linkedIdentities   LinkedIdentity[]
  authSessions       AuthSession[]
  verificationTokens VerificationToken[]
  loginEvents        LoginEvent[]

  // Employee operations. Both optional: a customer has neither, and an employee
  // has a profile but is on the other side of `customerWork`.
  employeeProfile  EmployeeProfile?  @relation("EmployeeIdentity")
  customerWork     WorkItem[]        @relation("CustomerWork")
  documentRequests DocumentRequest[] @relation("DocumentRequests")

  // Which tenant this person belongs to. Null for customers, who are the
  // platform's users rather than any organisation's staff.
  organizationId String?
  organization   Organization? @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([realm])
  @@index([role])
  @@index([organizationId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
}

// ── Auth: external identities ────────────────────────────────────────────────
// One row per way a person can prove who they are. Many per user, because the
// same customer may sign in with Google on their phone and with an insurer's
// OIDC at a branch, and both have to land on the same account.
//
// The pair (provider, subject) is the durable link — an email address is not,
// because people change theirs, and matching on one is only safe when the
// provider has told us it is verified.
model LinkedIdentity {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String // google | microsoft | apple | oidc:<issuer> | …
  subject  String // the provider's own stable id for this person

  // What the provider said at link time. Kept for support ("which account is
  // this?") and never used for matching — `subject` is the identity.
  email    String?
  linkedAt DateTime  @default(now())
  lastUsed DateTime?

  // One account per external identity. This is the constraint that stops two
  // Aegis users from claiming the same Google account.
  @@unique([provider, subject])
  @@index([userId])
}

// ── Auth: rotating refresh tokens (durable session revocation) ───────────────
// Only the SHA-256 hash of the opaque refresh token is stored (never the raw
// value). Rotation revokes the old row and inserts a new one; logout revokes.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // The sitting this credential belongs to. Nullable because tokens issued
  // before sessions existed have no sitting to point at, and inventing one for
  // them would put a fiction in the audit trail.
  sessionId String?
  session   AuthSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([sessionId])
}

// ── Identity: sittings ───────────────────────────────────────────────────────
// One row per "somebody signed in here, on this device, at this time".
//
// Deliberately NOT named `Session` — that name is already the AI conversation
// session further down this file, and two different things called Session in
// one schema is a defect waiting to be written. This is the *authentication*
// sitting; a refresh token is the credential that keeps it alive.
//
// Its reason for existing is that "sign me out everywhere" and "what is signed
// in to my account right now" are questions a bag of refresh tokens cannot
// answer legibly.
model AuthSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Copied at creation rather than read through to the user, because the answer
  // to "which portal was this sitting for" must not change retroactively when
  // somebody's realm is changed.
  realm String

  ipAddress String?
  userAgent String?

  // Future device trust. A remembered device can skip a second factor, which is
  // only safe once there is something durable to remember it by.
  deviceId    String?
  deviceLabel String?
  trustedAt   DateTime?

  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  // Why it ended: LOGOUT | LOGOUT_ALL | REPLAY | IDLE | ADMIN | EXPIRED
  revokedReason String?

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([userId, lastSeenAt])
}

// ── Identity: one-time proofs ────────────────────────────────────────────────
// Email verification and password reset are the same mechanism with different
// consequences, so they are one table with a `purpose` rather than two tables
// that would drift apart on expiry, single-use and hashing.
//
// Only the SHA-256 hash is stored. A reset table readable from a database dump
// is a table of live account takeovers.
model VerificationToken {
  id        String @id @default(uuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose String // EMAIL_VERIFICATION | PASSWORD_RESET

  // Bound to the address it was issued for. A reset link must stop working if
  // the account's email changes between issue and use.
  email String

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ── Identity: login history ──────────────────────────────────────────────────
// Every attempt, successful or not. Separate from AuditLog because this is the
// one trail a *customer* is entitled to read about their own account, and
// mixing it into the platform's audit stream would make that impossible to
// serve without leaking everything else.
//
// `email` is stored alongside `userId` because the interesting failures are the
// ones where no user was found.
model LoginEvent {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email   String
  // SUCCESS | BAD_CREDENTIALS | NO_ACCOUNT | LOCKED | INACTIVE | UNVERIFIED
  // | WRONG_REALM | PROVIDER_REJECTED
  outcome String
  // PASSWORD | google | microsoft | apple | …
  method  String
  realm   String?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
}

// ── Catalogue: companies & policies ──────────────────────────────────────────

model Company {
  id          String    @id @default(uuid())
  companyName String
  logo        String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)

  policies Policy[]

  @@index([companyName])
  @@index([deletedAt])
  // getCompanies lists all companies ordered by createdAt.
  @@index([createdAt])
}

model Policy {
  id         String    @id @default(uuid())
  policyName String
  premium    Float
  coverage   String
  companyId  String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime?
  version    Int       @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Which tenant owns this record.
  ///
  /// Nullable because rows created before multi-tenancy have no organisation to
  /// belong to and none may be invented for them. A null is invisible to every
  /// tenant-scoped query — fail closed — until an operator assigns it.
  organizationId String?
  organization   Organization? @relation("OrgPolicy", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([companyId])
  @@index([policyName])
  @@index([deletedAt])
}

// ── Sales pipeline: leads ────────────────────────────────────────────────────

model Lead {
  id            String    @id @default(uuid())
  customerName  String
  email         String
  phone         String
  insuranceType String
  budget        String
  status        String    @default("pending") // pending | contacted | qualified | won | lost
  assignedToId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?
  version       Int       @default(1)

  assignedTo User? @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Which tenant owns this record.
  ///
  /// Nullable because rows created before multi-tenancy have no organisation to
  /// belong to and none may be invented for them. A null is invisible to every
  /// tenant-scoped query — fail closed — until an operator assigns it.
  organizationId String?
  organization   Organization? @relation("OrgLead", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status, createdAt])
  @@index([email])
  @@index([assignedToId])
  @@index([deletedAt])
  // Unfiltered admin list (getLeads) sorts by createdAt with no status filter,
  // which the leading-column [status, createdAt] index cannot serve.
  @@index([createdAt])
}

// ── Conversations ────────────────────────────────────────────────────────────

model Chat {
  id          String    @id @default(uuid())
  message     String
  sender      String // customer | advisor
  sessionId   String?
  userId      String?
  agentName   String?
  agentDomain String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([agentDomain])
  @@index([deletedAt])
}

// ── Documents ────────────────────────────────────────────────────────────────

model UploadedDocument {
  id          String    @id @default(uuid())
  filename    String
  filepath    String
  ownerId     String? // scopes documents to their uploader (closes the upload IDOR)
  mimeType    String?
  sizeBytes   Int?
  contentHash String? // SHA-256 of the file bytes — used for duplicate detection
  uploadedAt  DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  // ── Document intelligence ──────────────────────────────────────────────────
  // Added in the document platform sprint. Until then a document recorded who
  // uploaded it and when, and nothing about whether anybody had looked at it —
  // which the platform's own compliance check surfaced as a finding.

  /// What kind of document this is. Null until classification has run.
  category    String?
  /// The requirement it was uploaded against, if it answered one.
  documentKey String?
  /// The domain that asked for it: health | motor | travel | home-property.
  domain      String?

  /// UPLOADED | PROCESSING | PENDING_REVIEW | VERIFIED | REJECTED | REPLACED
  ///
  /// A pipeline stage and a verification outcome are deliberately one field:
  /// they are the same question — "can this be relied on yet" — and two fields
  /// would allow the impossible state of VERIFIED while still PROCESSING.
  status String @default("UPLOADED")

  /// Set when a person decides. Never set by the pipeline.
  verifiedAt      DateTime?
  verifiedById    String?
  /// Why it was rejected. Shown to the customer, so it must be actionable.
  rejectionReason String?

  /// The document that replaced this one, when a customer re-supplied it.
  replacedById String?

  /// JSON from the extraction stage. Free-form because what is worth pulling
  /// out of a passport differs entirely from a hospital bill.
  extractedData String?
  /// 0–1 from the fraud stage. Null when the stage has not run.
  riskScore     Float?
  riskReason    String?

  owner  User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  events DocumentEvent[]

  /// Which tenant owns this record.
  ///
  /// Nullable because rows created before multi-tenancy have no organisation to
  /// belong to and none may be invented for them. A null is invisible to every
  /// tenant-scoped query — fail closed — until an operator assigns it.
  organizationId String?
  organization   Organization? @relation("OrgUploadedDocument", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ownerId])
  @@index([deletedAt])
  // Admin document listing (getUploadedDocuments) sorts all rows by uploadedAt.
  @@index([uploadedAt])
  // Duplicate detection: look up a prior upload by the same owner + content hash.
  @@index([ownerId, contentHash])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI-platform tables — PREPARED for the multi-agent engine, recommendation
// history, transfers, notifications and audit. These are additive and not yet
// wired into the (currently file-backed) AI memory, so no AI workflow changes.
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id          String    @id @default(uuid())
  sessionId   String    @unique // external session id used by the AI engine
  userId      String?
  agentDomain String? // health | motor | travel | home-property | executive
  agentName   String?
  status      String    @default("active") // active | transferred | closed
  startedAt   DateTime  @default(now())
  lastActive  DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  user            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  chats           Chat[]
  recommendations RecommendationHistory[]
  transfers       AgentTransfer[]

  @@index([userId, lastActive])
  @@index([status])
  @@index([agentDomain])
}

model RecommendationHistory {
  id          String   @id @default(uuid())
  userId      String?
  sessionId   String?
  domain      String // health | motor | travel | home-property
  planName    String?
  score       Float?
  confidence  Float?
  approval    String? // Approved | Pending | Rejected
  profileHash String? // ties a recommendation to the profile snapshot it was built from
  payload     String? // JSON blob of the full recommendation
  createdAt   DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([domain])
  @@index([profileHash])
}

model AgentTransfer {
  id         String   @id @default(uuid())
  sessionId  String?
  fromDomain String?
  toDomain   String?
  fromAgent  String?
  toAgent    String?
  reason     String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  session Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([toDomain])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // system | underwriting | claim | renewal | payment
  title     String
  body      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  // ── Sprint 10 additions ────────────────────────────────────────────────────
  // Added to the existing model rather than replacing it. `isRead` stays and
  // stays authoritative for read/unread; `status` adds the third state the
  // original two booleans could not express. Code that predates this keeps
  // working, which is the point of extending rather than migrating.

  /// POLICY | CLAIM | DOCUMENT | RENEWAL | SECURITY | ANNOUNCEMENT | MAINTENANCE | AI_SUGGESTION | TASK | MESSAGE
  category String @default("ANNOUNCEMENT")
  /// UNREAD | READ | ARCHIVED
  status   String @default("UNREAD")
  /// LOW | NORMAL | HIGH | URGENT
  priority String @default("NORMAL")

  /// Where this notification points. A relative portal path, never a full URL —
  /// an absolute URL in a notification is a phishing vector waiting for someone
  /// to write it into the wrong field.
  deepLink String?

  /// What it is about, so a timeline can group by subject without a join table.
  subjectKind String? // workItem | document | policy | conversation | intelligenceRun
  subjectId   String?

  /// Collapses repeats. Two "renewal due" notices for one policy in a week is
  /// how people learn to ignore the notification bell.
  dedupeKey String?

  archivedAt  DateTime?
  deliveredAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([type])
  @@index([userId, status, createdAt])
  @@index([userId, category, createdAt])
  @@index([dedupeKey])
  @@index([subjectKind, subjectId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String? // the user who performed the action (null = system)
  action    String // e.g. auth.login, lead.update, policy.create
  entity    String? // model name
  entityId  String? // affected row id
  metadata  String? // JSON blob of contextual detail (never store secrets/PII in clear)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}

// ═════════════════════════════════════════════════════════════════════════════
// EMPLOYEE OPERATIONS
//
// The work an insurance employee actually does, and the record of doing it.
// Nothing here is customer-facing; every query is scoped by the employee's
// assignment or by a capability they hold.
// ═════════════════════════════════════════════════════════════════════════════

/// Who somebody is *at work* — distinct from who they are as an account.
///
/// Separate from `User` because the two have different lifetimes and different
/// owners: an account exists the moment somebody can sign in, while a
/// department, a branch and a reporting line are facts HR maintains and change
/// without the account changing at all. Folding them into `User` would also put
/// staff-only columns on every customer row.
model EmployeeProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("EmployeeIdentity", fields: [userId], references: [id], onDelete: Cascade)

  /// The number on the badge. Human-facing, unique, and not the primary key —
  /// employee numbering schemes get reissued and reformatted; ids must not.
  employeeCode String @unique

  department  String // claims | underwriting | servicing | support | operations
  designation String
  branch      String

  /// Reporting line. Self-referential and nullable, because somebody has to be
  /// at the top and a new joiner may not be assigned yet.
  managerId String?
  manager   EmployeeProfile?  @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports   EmployeeProfile[] @relation("ReportsTo")

  status   String    @default("ACTIVE") // ACTIVE | ON_LEAVE | SUSPENDED | EXITED
  joinedAt DateTime  @default(now())
  exitedAt DateTime?

  /// How much work the router may hand them at once. A number rather than a
  /// policy so a team lead can lower it for somebody who is training.
  workloadLimit Int @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  assignedWork WorkItem[]     @relation("AssignedTo")
  workflowActs WorkflowStep[] @relation("StepActor")

  /// Which tenant owns this record.
  ///
  /// Nullable because rows created before multi-tenancy have no organisation to
  /// belong to and none may be invented for them. A null is invisible to every
  /// tenant-scoped query — fail closed — until an operator assigns it.
  organizationId String?
  organization   Organization? @relation("OrgEmployeeProfile", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([department, status])
  @@index([branch])
  @@index([managerId])
}

/// One piece of work, whatever kind it is.
///
/// A claim, a KYC check, a renewal and a complaint are different *processes*
/// but the same *thing* to the person doing them: something arrived, it has a
/// priority and a due time, somebody owns it, and it ends. Modelling them as
/// one table with a `kind` is what makes "my queue", "team workload" and
/// "average resolution time" single queries rather than four unions that drift.
///
/// The process-specific detail lives in the workflow attached to it.
model WorkItem {
  id        String @id @default(uuid())
  /// CLAIM | KYC | RENEWAL | COMPLAINT | APPOINTMENT | TASK
  kind      String
  /// Human reference, e.g. CLM-2026-000123. What people say on the phone.
  reference String @unique

  title   String
  summary String?

  /// OPEN | IN_PROGRESS | AWAITING_CUSTOMER | AWAITING_APPROVAL | RESOLVED | CLOSED | CANCELLED
  status   String @default("OPEN")
  /// LOW | NORMAL | HIGH | URGENT
  priority String @default("NORMAL")

  assigneeId String?
  assignee   EmployeeProfile? @relation("AssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// The customer this concerns. Nullable because internal tasks have none.
  customerId String?
  customer   User?   @relation("CustomerWork", fields: [customerId], references: [id], onDelete: SetNull)

  /// When it should be done by, and the promise it was measured against.
  dueAt        DateTime?
  slaMinutes   Int?
  openedAt     DateTime  @default(now())
  firstTouchAt DateTime?
  resolvedAt   DateTime?
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // ── Sprint 10 additions ────────────────────────────────────────────────────
  // This is the platform's task system and it already had assignment, priority,
  // due dates, status, owner and a workflow link. Building a second `Task`
  // model beside it would have split every employee's queue in two.

  /// Which team owns it. Null when it is personal rather than departmental.
  department String?

  /// HUMAN | AI | SYSTEM — who proposed this task.
  ///
  /// An AI-suggested task is created in the same table as any other so it lands
  /// in the same queue, but it is labelled, because an employee is entitled to
  /// know whether a person or a model decided this needed doing.
  origin String @default("HUMAN")

  /// For an AI suggestion: why it was raised, in words the assignee can judge.
  originRationale String?

  workflow WorkflowRun?
  events   WorkItemEvent[]

  // "My open queue, most urgent first" is the hottest read in the product.

  /// Which tenant owns this record.
  ///
  /// Nullable because rows created before multi-tenancy have no organisation to
  /// belong to and none may be invented for them. A null is invisible to every
  /// tenant-scoped query — fail closed — until an operator assigns it.
  organizationId String?
  organization   Organization? @relation("OrgWorkItem", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([assigneeId, status, dueAt])
  @@index([status, priority])
  @@index([kind, status])
  @@index([customerId])
  @@index([openedAt])
}

/// The timeline on a piece of work. Append-only.
///
/// Separate from AuditLog because this is operational history a colleague reads
/// to pick up somebody else's case — not a compliance trail. Mixing them would
/// mean either leaking the platform's audit stream into a case view, or
/// building a second one later anyway.
model WorkItemEvent {
  id         String   @id @default(uuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  /// ASSIGNED | STATUS_CHANGED | NOTE | STEP_COMPLETED | ESCALATED | CONTACTED
  kind    String
  /// Who did it. Null when the system or a scheduled job did.
  actorId String?
  summary String
  detail  String? // JSON; SQLite has no native type and this targets Postgres too

  createdAt DateTime @default(now())

  @@index([workItemId, createdAt])
}

/// A running instance of one of the agentic workflows.
///
/// The definition is a name, not a stored graph. The steps a claim goes through
/// are business rules that belong in reviewed code, not in rows somebody can
/// edit into an unreachable state — and a workflow that can be rewritten at
/// runtime cannot be reasoned about when a claim is disputed months later.
model WorkflowRun {
  id         String   @id @default(uuid())
  workItemId String   @unique
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  /// CLAIM_APPROVAL | KYC | RENEWAL | COMPLAINT
  definition  String
  /// The step key it is sitting on. Null once finished.
  currentStep String?
  /// RUNNING | AWAITING_HUMAN | COMPLETED | REJECTED | ABANDONED
  status      String  @default("RUNNING")

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  steps WorkflowStep[]

  @@index([definition, status])
  @@index([status])
}

/// One step of a running workflow, and who completed it.
///
/// `actorKind` records whether a person, a rule or the assistant did it. That
/// distinction is the whole point of a human-approval gate: months later,
/// "who approved this claim" must have an answer that is not "the software".
model WorkflowStep {
  id    String      @id @default(uuid())
  runId String
  run   WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Stable key from the definition, e.g. "document_validation".
  key   String
  name  String
  order Int

  /// PENDING | IN_PROGRESS | COMPLETED | SKIPPED | REJECTED
  status    String           @default("PENDING")
  /// SYSTEM | ASSISTANT | EMPLOYEE
  actorKind String?
  actorId   String?
  actor     EmployeeProfile? @relation("StepActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// APPROVE | REJECT | ESCALATE | REQUEST_INFO — set on decision steps only.
  decision   String?
  notes      String?
  /// What the assistant suggested, kept even when a human overrode it. That
  /// disagreement is the most useful record this table holds.
  suggestion String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([runId, key])
  @@index([runId, order])
  @@index([status])
}

/// The knowledge an employee searches: SOPs, circulars, product notes, IRDAI
/// guidance. Stored rather than fetched from a wiki so search, permissions and
/// versioning are the platform's problem and not a second system's.
model KnowledgeArticle {
  id       String  @id @default(uuid())
  slug     String  @unique
  title    String
  /// POLICY | SOP | CIRCULAR | GUIDELINE | FAQ | TRAINING | PRODUCT
  category String
  summary  String
  body     String
  /// Comma-separated; SQLite has no list type and this schema targets both.
  tags     String?

  /// Which departments it applies to. Null means everyone.
  departments String?

  version     Int      @default(1)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // ── Sprint 11 additions ────────────────────────────────────────────────────
  // The table already held articles and was already searched. What it lacked
  // was governance: nothing recorded whether an article had been approved, who
  // approved it, when it stopped being true, or what it said last month.
  //
  // For a platform quoting IRDAI regulation to customers, "what did our
  // guidance say on the day we gave that advice" is a question with regulatory
  // weight, and an UPDATE that overwrites the answer destroys it.

  /// DRAFT | IN_REVIEW | APPROVED | ARCHIVED
  ///
  /// Only APPROVED is ever served to an assistant or a customer. A draft
  /// regulation summary that reached a customer would be worse than no
  /// summary — they would act on it.
  status String @default("APPROVED")

  /// PUBLIC | INTERNAL | RESTRICTED — who may read it, independent of role.
  /// RESTRICTED needs an explicit grant; INTERNAL needs any staff realm.
  classification String @default("INTERNAL")

  /// When the guidance takes effect and when it stops being true. A circular
  /// superseded in March must not be quoted in April.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  /// Where it came from — an IRDAI circular number, an internal doc, a URL.
  /// Advice that cannot be traced to a source cannot be defended.
  sourceRef  String?
  sourceKind String? // IRDAI | INTERNAL | INSURER | STATUTE | MANUAL

  authorId     String?
  approvedById String?
  approvedAt   DateTime?
  /// When it should next be checked. Regulation goes stale silently.
  reviewDueAt  DateTime?
  archivedAt   DateTime?

  /// Read counters, so knowledge analytics can show what is actually used
  /// rather than what was merely written.
  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  /// The domain category. Nullable so existing rows stay valid — an article
  /// filed before categories existed is uncategorised, not broken.
  categoryId String?
  taxonomy   KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  versions    KnowledgeVersion[]
  reviews     KnowledgeReview[]
  articleTags KnowledgeArticleTag[]
  permissions KnowledgePermission[]

  @@index([category])
  @@index([publishedAt])
  @@index([status, category])
  @@index([classification, status])
  @@index([reviewDueAt])
  @@index([effectiveFrom, effectiveTo])
  @@index([categoryId, status])
}

/// What an article said at a point in time.
///
/// Append-only. Every approved change writes a row before the article is
/// updated, so "what did our guidance say when we told the customer that" has
/// an answer. This is the whole reason the knowledge base is not just a table
/// with an `updatedAt`.
model KnowledgeVersion {
  id        String @id @default(uuid())
  articleId String

  version    Int
  title      String
  summary    String
  body       String
  /// Why it changed. A diff without a reason is archaeology.
  changeNote String?

  authoredById String?
  createdAt    DateTime @default(now())

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([articleId, createdAt])
}

/// A person's decision about an article.
model KnowledgeReview {
  id        String @id @default(uuid())
  articleId String

  /// APPROVED | REJECTED | CHANGES_REQUESTED | SCHEDULED_REVIEW
  decision   String
  reviewerId String
  /// Required for anything but APPROVED — the same rule the document platform
  /// applies to a rejection.
  notes      String?

  createdAt DateTime @default(now())

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([reviewerId])
}

// ═════════════════════════════════════════════════════════════════════════════
// PLATFORM ADMINISTRATION
//
// The tenancy, configuration and licensing the platform operator manages.
// Everything here is above an organisation rather than inside one.
// ═════════════════════════════════════════════════════════════════════════════

/// A tenant: an insurer, a broker, an agency using Aegis.
///
/// Distinct from `Company`, which is the *product catalogue* — the insurers
/// whose policies customers compare. The two look similar and are not: an
/// organisation is somebody who pays for Aegis and whose staff sign in; a
/// company is a name on a policy. Conflating them would mean deleting a tenant
/// silently removed products from every customer's comparison.
model Organization {
  id   String @id @default(uuid())
  /// Stable, human-facing, used in support conversations and URLs.
  slug String @unique
  name String

  /// ACTIVE | SUSPENDED | ARCHIVED
  ///
  /// Suspension is reversible and archival is not-quite-deletion. A hard delete
  /// of a tenant would orphan every record their staff created, so the console
  /// archives instead and says so.
  status String @default("ACTIVE")

  /// Where their people sign in from. Drives the workspace-domain check that
  /// separates "Google" from "Google Workspace" for this tenant.
  emailDomains String? // comma-separated

  contactEmail String?
  contactPhone String?

  /// Free-form operator notes. Never shown to the tenant.
  notes String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  archivedAt DateTime?

  members User[]   @relation("OrganizationMembers")
  license License?

  // Tenant-owned business records.
  orgPolicys           Policy[]           @relation("OrgPolicy")
  orgLeads             Lead[]             @relation("OrgLead")
  orgUploadedDocuments UploadedDocument[] @relation("OrgUploadedDocument")
  orgWorkItems         WorkItem[]         @relation("OrgWorkItem")
  orgEmployeeProfiles  EmployeeProfile[]  @relation("OrgEmployeeProfile")
  orgHeldPolicys       HeldPolicy[]       @relation("OrgHeldPolicy")
  orgInsuranceProfiles InsuranceProfile[] @relation("OrgInsuranceProfile")
  orgDocumentRequests  DocumentRequest[]  @relation("OrgDocumentRequest")
  orgIntelligenceRuns  IntelligenceRun[]  @relation("OrgIntelligenceRun")

  @@index([status])
  @@index([createdAt])
}

/// What an organisation has bought.
///
/// One per organisation, replaced rather than versioned — the question this
/// answers is "what are they entitled to right now", and a history of past
/// plans belongs in the audit trail rather than here.
model License {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// TRIAL | STANDARD | ENTERPRISE
  plan String @default("TRIAL")

  /// How many staff accounts they may hold. Customers are not seats — they are
  /// the product's users, not its licensees, and charging per customer would
  /// make the platform's incentives point the wrong way.
  seats Int @default(5)

  startsAt  DateTime  @default(now())
  /// Null means perpetual. A trial without an end date is a bug, not a gift.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([plan])
  @@index([expiresAt])
}

/// Platform configuration held in the database rather than only in environment.
///
/// Environment variables are the right home for secrets and for anything a
/// process needs before it can talk to a database. Everything else — feature
/// flags, thresholds, branding — is better here, because changing it should not
/// require a deployment and every change should leave a trace.
///
/// Values are stored as strings with a declared `type`, so a reader can coerce
/// safely and a bad value is a visible parse failure rather than a silent
/// `NaN` somewhere downstream.
model PlatformSetting {
  key   String @id
  value String
  /// string | number | boolean | json
  type  String @default("string")

  /// Grouping for the console: auth | security | email | storage | ai | branding
  category    String  @default("general")
  label       String
  description String?

  /// Whether the value may be shown in full. A secret is stored elsewhere; this
  /// flag is for values that are not secret but are noisy or misleading out of
  /// context.
  sensitive Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?

  @@index([category])
}

// ═════════════════════════════════════════════════════════════════════════════
// DOCUMENT INTELLIGENCE
//
// The lifecycle a document goes through after it is uploaded, and the requests
// that asked for it in the first place.
// ═════════════════════════════════════════════════════════════════════════════

/// What a document is *for*, and where it has reached.
///
/// These columns are additive on `UploadedDocument` rather than a new table,
/// because they describe the same object — splitting them would mean every read
/// of a document became a join, and every write a transaction, for fields that
/// are never absent once the pipeline has run.
model DocumentEvent {
  id         String           @id @default(uuid())
  documentId String
  document   UploadedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// UPLOADED | SCANNING | SCANNED | EXTRACTING | EXTRACTED | VALIDATING
  /// | VALIDATED | ANALYSING | ANALYSED | VERIFIED | REJECTED | REPLACED | DELETED
  stage     String
  /// SYSTEM | ASSISTANT | EMPLOYEE — who moved it. "The software verified it"
  /// is not an acceptable answer months later, so the actor is always recorded.
  actorKind String
  actorId   String?

  /// What happened, in a sentence a colleague can read.
  summary String
  /// JSON. Structured findings from whichever service produced this stage.
  detail  String?

  createdAt DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([stage])
}

/// A document the platform has asked somebody for.
///
/// The requirements are *not* hardcoded per product in the UI. An agent decides
/// what a given application needs and writes these rows; the upload surface
/// renders whatever it finds. That is what lets a new product, or a customer
/// whose circumstances change the requirement, work without a front-end change.
model DocumentRequest {
  id String @id @default(uuid())

  /// Who is being asked.
  subjectId String
  subject   User   @relation("DocumentRequests", fields: [subjectId], references: [id], onDelete: Cascade)

  /// Which piece of work this belongs to. Empty string when it belongs to none.
  ///
  /// A sentinel rather than NULL, because the unique constraint below includes
  /// this column — and in SQL `NULL != NULL`, so a nullable column in a unique
  /// index does not constrain anything. With NULL here, asking the same
  /// customer for the same document twice outside a work item would insert a
  /// second row every time.
  workItemId String @default("")

  /// health | motor | travel | home-property | general — the domain that asked.
  domain      String
  /// Stable key, e.g. `rc_book`. What the platform calls this document.
  documentKey String
  /// What a person reads: "Vehicle registration certificate".
  label       String
  description String?

  /// Whether the application can proceed without it.
  required Boolean @default(true)
  /// PENDING | SUPPLIED | WAIVED | EXPIRED
  status   String  @default("PENDING")

  /// Why it was asked for. Shown to the customer, because "we need your RC book"
  /// is far less useful than "to confirm the vehicle is registered to you".
  reason String?

  /// The document that satisfied it, once one has.
  fulfilledById String?
  fulfilledAt   DateTime?

  requestedBy String? // agent or employee id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  /// Which tenant owns this record.
  ///
  /// Nullable because rows created before multi-tenancy have no organisation to
  /// belong to and none may be invented for them. A null is invisible to every
  /// tenant-scoped query — fail closed — until an operator assigns it.
  organizationId String?
  organization   Organization? @relation("OrgDocumentRequest", fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([subjectId, workItemId, documentKey])
  @@index([organizationId])
  @@index([subjectId, status])
  @@index([workItemId])
}

// ── Insurance intelligence ───────────────────────────────────────────────────
//
// Everything the platform needs to reason about a customer's *protection*, as
// opposed to their conversation. The AI keeps a conversational profile of its
// own under `Aegis-AI/layer3`; this is the structured, auditable version that
// survives a session ending and that an employee can look at.
//
// The two are not duplicates. The conversational profile is what the customer
// has said so far; this is what the business knows and is prepared to act on.

///
/// A customer's insurance profile.
///
/// One per customer. Every field is optional because a profile is built up over
/// time — a customer who has answered three questions has a real profile, and
/// refusing to store it until it is complete is how platforms lose the three
/// answers. Completeness is computed, not enforced.
model InsuranceProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Who they are
  age         Int?
  occupation  String?
  incomeRange String? // BELOW_3L | 3L_6L | 6L_12L | 12L_25L | ABOVE_25L
  city        String?
  state       String?

  // Who depends on them. `dependents` is not `familyMembers`: a household of
  // four with two earners carries different risk from one with a single earner,
  // and that distinction drives the whole life-cover recommendation.
  maritalStatus    String? // SINGLE | MARRIED | WIDOWED | SEPARATED
  familyMembers    Int?
  dependents       Int?
  parentsDependent Boolean?

  // What they own and do
  vehicleOwnership  String? // JSON array: [{ kind, make, year, commercial }]
  propertyOwnership String? // JSON array: [{ kind, ownership, valueRange }]
  travelFrequency   String? // NEVER | RARE | OCCASIONAL | FREQUENT | INTERNATIONAL

  // Health. Optional in the strongest sense: never required to get a
  // recommendation, and absence is treated as unknown rather than as healthy.
  healthConditions String? // JSON array of strings
  smoker           Boolean?

  // What they want
  financialGoals String? // JSON array: RETIREMENT | CHILD_EDUCATION | WEALTH | …
  riskPreference String? // CONSERVATIVE | BALANCED | AGGRESSIVE

  // What they have been through. Prior claims and lapses change both risk and
  // how the platform should talk to somebody.
  insuranceHistory String? // JSON: { yearsHeld, priorClaims, lapses }

  // Bookkeeping
  profileHash  String? // snapshot identity, so a cached analysis can be invalidated
  completeness Int      @default(0) // 0–100, computed on write
  source       String   @default("SELF") // SELF | ADVISOR | AI | IMPORT
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  heldPolicies HeldPolicy[]
  analyses     IntelligenceRun[]

  /// Which tenant owns this record.
  ///
  /// Nullable because rows created before multi-tenancy have no organisation to
  /// belong to and none may be invented for them. A null is invisible to every
  /// tenant-scoped query — fail closed — until an operator assigns it.
  organizationId String?
  organization   Organization? @relation("OrgInsuranceProfile", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([updatedAt])
  @@index([profileHash])
}

///
/// A policy the customer actually holds — here or anywhere else.
///
/// Distinct from `Policy`, which is a product in a company's catalogue. Coverage
/// gap analysis is impossible without knowing what somebody already has,
/// including cover bought elsewhere, and a customer who is told to buy health
/// insurance they already own stops trusting the platform.
model HeldPolicy {
  id        String @id @default(uuid())
  profileId String

  domain       String // motor | health | life | travel | property | commercial
  insurer      String?
  productName  String?
  policyNumber String?

  sumInsured  Float?
  premium     Float?
  startDate   DateTime?
  renewalDate DateTime?

  /// Whether Aegis sold it. Cover held elsewhere still counts as cover.
  external Boolean @default(true)
  status   String  @default("ACTIVE") // ACTIVE | LAPSED | EXPIRED | CANCELLED

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  profile InsuranceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Which tenant owns this record.
  ///
  /// Nullable because rows created before multi-tenancy have no organisation to
  /// belong to and none may be invented for them. A null is invisible to every
  /// tenant-scoped query — fail closed — until an operator assigns it.
  organizationId String?
  organization   Organization? @relation("OrgHeldPolicy", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([profileId, domain])
  @@index([renewalDate])
  @@index([status])
}

///
/// One run of the intelligence engine, kept.
///
/// Recommendations are retained rather than recomputed on demand for two
/// reasons: a customer must be able to ask why they were told something last
/// month, and a regulator may require the same. The `profileHash` records which
/// version of the facts produced it, so "the advice changed" can be answered
/// with "because your circumstances did".
model IntelligenceRun {
  id        String  @id @default(uuid())
  profileId String
  userId    String?

  kind        String // NEED | RECOMMENDATION | GAP | RISK | RENEWAL | FULL
  profileHash String
  payload     String // JSON of the full report, including every explanation
  confidence  Float?

  /// Which engine produced it, so a change in advice can be traced to a change in code.
  engineVersion String   @default("1.0.0")
  createdAt     DateTime @default(now())

  profile InsuranceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Which tenant owns this record.
  ///
  /// Nullable because rows created before multi-tenancy have no organisation to
  /// belong to and none may be invented for them. A null is invisible to every
  /// tenant-scoped query — fail closed — until an operator assigns it.
  organizationId String?
  organization   Organization? @relation("OrgIntelligenceRun", fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([profileId, kind, createdAt])
  @@index([userId, createdAt])
  @@index([profileHash])
}

// ── Communication & collaboration ────────────────────────────────────────────
//
// The platform already had two kinds of conversation: `Chat`, which is a
// customer talking to the AI, and `WorkItemEvent`, which is the operational
// history of a case. Neither is a conversation *between people*, and that is
// what this section adds.
//
// One model serves every pairing — customer to advisor, advisor to advisor,
// admin to department — because a thread is a thread. What differs is who may
// join and what may be said, and that is authorisation, not schema.

/// A thread.
model Conversation {
  id String @id @default(uuid())

  /// DIRECT | CASE | INTERNAL | ANNOUNCEMENT
  ///
  /// CASE threads hang off a work item and are visible to its participants.
  /// INTERNAL threads are staff-only and must never be shown to a customer —
  /// that distinction is enforced in the service, and this field is what it
  /// reads.
  kind String

  subject String?

  /// The work item this concerns, when it concerns one.
  workItemId String?

  /// The customer this concerns. Set even on INTERNAL threads, so a colleague
  /// can find the internal discussion about a case — it does not imply the
  /// customer can read it.
  customerId String?

  /// OPEN | RESOLVED | ARCHIVED
  status String @default("OPEN")

  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  /// Denormalised so an inbox can sort without touching the messages table.
  lastMessageAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([kind, status, lastMessageAt])
  @@index([workItemId])
  @@index([customerId, kind])
  @@index([lastMessageAt])
}

/// Who is in a thread, and what they have read.
///
/// Membership is a row rather than a computed rule. A computed rule ("everyone
/// with claim.read may see claim threads") means a person's access to an old
/// conversation changes silently when their role changes, and nobody can answer
/// "who saw this?" afterwards.
model ConversationParticipant {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  /// OWNER | MEMBER | OBSERVER — observers may read but not post.
  role String @default("MEMBER")

  lastReadAt DateTime?
  mutedAt    DateTime?
  leftAt     DateTime?
  addedAt    DateTime  @default(now())
  addedById  String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

/// One message.
model Message {
  id             String @id @default(uuid())
  conversationId String

  /// Null when the sender is the platform or an AI agent — see `senderKind`.
  senderId    String?
  /// USER | AI | SYSTEM
  senderKind  String  @default("USER")
  /// Which agent, when senderKind is AI. Named so a customer can be told.
  senderAgent String?

  body String

  /// NOTE | REPLY | SUMMARY | SUGGESTION | SYSTEM_EVENT
  ///
  /// SUGGESTION is a draft the Communication AI proposed. It is stored like any
  /// other message but never delivered until a person sends it, which is the
  /// difference between an assistant and an impersonation.
  kind String @default("REPLY")

  /// True for staff-only notes on a customer-visible thread.
  internal Boolean @default(false)

  /// Uploaded documents referenced by this message, as a JSON array of ids.
  /// Ids only — the document platform stays the single authority on access.
  attachmentIds String?

  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mentions     Mention[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([conversationId, internal, createdAt])
}

/// Somebody named in a message.
model Mention {
  id        String @id @default(uuid())
  messageId String
  userId    String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

/// How somebody wants to be contacted.
///
/// Channels that do not exist yet are stored but reported as unavailable rather
/// than silently accepted. A user who switches on SMS and hears nothing has
/// been lied to; one who is told SMS is not connected yet has been informed.
model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique

  inApp Boolean @default(true)
  email Boolean @default(true)
  sms   Boolean @default(false)
  push  Boolean @default(false)

  /// IMMEDIATE | DAILY | WEEKLY — how often reminders may repeat.
  reminderFrequency String @default("IMMEDIATE")

  /// BCP 47. The platform serves Tamil, Thanglish and English speakers.
  language String @default("en")

  /// Categories the user has switched off, as a JSON array.
  /// Security alerts are never suppressible and the service enforces that.
  mutedCategories String?

  /// Local time window during which only urgent notifications are delivered.
  quietHoursStart String? // "22:00"
  quietHoursEnd   String? // "07:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A broadcast to a realm, department or the whole platform.
///
/// Kept apart from Notification because an announcement is written once and
/// read by thousands. Fanning one out into a row per recipient would turn a
/// company-wide message into a hundred thousand writes.
model Announcement {
  id String @id @default(uuid())

  title String
  body  String

  /// ALL | CUSTOMER | EMPLOYEE | ENTERPRISE | PLATFORM
  audienceRealm      String  @default("ALL")
  /// Narrows further within a realm. Null means the whole realm.
  audienceDepartment String?

  /// NORMAL | HIGH | URGENT
  priority String @default("NORMAL")
  /// ANNOUNCEMENT | MAINTENANCE | SECURITY | POLICY_BROADCAST
  category String @default("ANNOUNCEMENT")

  publishedAt DateTime?
  expiresAt   DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  reads AnnouncementRead[]

  @@index([audienceRealm, publishedAt])
  @@index([publishedAt, expiresAt])
}

/// Who has seen an announcement. Written on read, so the table stays small.
model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

/// A record that something happened and who was told.
///
/// This is the delivery ledger, not the timeline. The timeline is assembled at
/// read time from the systems that already record their own history — work
/// items, documents, intelligence runs — because copying their events here
/// would create a second version of the truth that drifts from the first.
///
/// What this table adds is the part nobody else records: which channel a
/// message went out on, and whether it arrived.
model DeliveryRecord {
  id String @id @default(uuid())

  notificationId String?
  userId         String

  /// IN_APP | EMAIL | SMS | PUSH | REALTIME
  channel String
  /// PENDING | SENT | DELIVERED | FAILED | SUPPRESSED
  status  String @default("PENDING")

  /// Why it was suppressed or failed. Populated for anything but SENT.
  reason String?

  /// Milliseconds from the event being raised to this row reaching SENT.
  latencyMs Int?

  attemptedAt DateTime  @default(now())
  settledAt   DateTime?

  @@index([userId, attemptedAt])
  @@index([channel, status])
  @@index([notificationId])
  @@index([status, attemptedAt])
}

// ── Institutional memory ─────────────────────────────────────────────────────
//
// What the business durably knows about someone, as opposed to what an agent
// remembers mid-conversation.
//
// The distinction is deliberate and load-bearing. `ai-python/app/memory` and
// `Aegis-AI/layer3` hold *working* memory: the state of a conversation in
// flight, namespaced per agent, and rightly isolated so one domain cannot read
// another's. This table holds *institutional* memory: facts the business has
// decided to keep, with provenance, an owner, an expiry, and an audit trail.
//
// Conflating the two would break agent isolation — the crown jewel this
// codebase protects — so nothing here reads or writes an agent's namespace.
// Facts arrive by being asserted through the service, and an agent that wants
// one asks for it.

model MemoryRecord {
  id String @id @default(uuid())

  /// Whose memory this is.
  /// CUSTOMER | EMPLOYEE | ORGANIZATION | PLATFORM
  scope     String
  /// The subject within that scope — a userId, an organisationId.
  subjectId String

  /// PREFERENCE | FACT | CONTEXT | HISTORY | CONSENT | CONSTRAINT
  kind  String
  /// A stable key, e.g. "contact.preferred_channel" or "claim.prior_count".
  /// Namespaced by dots so a family of facts can be read together.
  key   String
  /// JSON. Typed values would need a column per type or a lossy cast.
  value String

  /// 0–1. How much the platform trusts this. A fact inferred from one
  /// conversation is not a fact the customer confirmed, and advice built on the
  /// two should not sound equally certain.
  confidence Float @default(1)

  /// Where it came from: CUSTOMER_STATED | ADVISOR_ENTERED | AI_INFERRED |
  /// DOCUMENT | SYSTEM. Provenance is what lets somebody challenge a fact.
  source    String  @default("SYSTEM")
  /// The specific thing it came from — a conversationId, a documentId, a run.
  sourceRef String?

  /// When this stops being trustworthy. A stated preference does not expire; an
  /// inference from a two-year-old conversation should.
  expiresAt DateTime?

  /// Superseding rather than overwriting. "They preferred email, now they
  /// prefer phone" is a history worth keeping — and a fact that was acted on
  /// must remain visible after it changes.
  supersededById String?   @unique
  supersededAt   DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // One live value per key per subject is enforced in the service rather than
  // by a unique constraint, because superseded rows share the key by design.
  @@index([scope, subjectId, key])
  @@index([scope, subjectId, kind])
  @@index([expiresAt])
  @@index([supersededAt])
}

// ── Knowledge organisation ───────────────────────────────────────────────────

/// A domain category: motor, health, claims, compliance, and so on.
///
/// A table rather than an enum because categories are business vocabulary that
/// changes without a deploy, and because the router and the analytics both need
/// to attach behaviour to one — which a bare string cannot carry.
///
/// Distinct from `KnowledgeArticle.category`, which is the *document type*
/// (SOP, circular, FAQ). An article is both: a claims SOP is category "claims",
/// type "SOP". Collapsing the two would make "every FAQ about motor" unaskable.
model KnowledgeCategory {
  id   String @id @default(uuid())
  slug String @unique
  name String

  /// Free text, shown to whoever is filing an article.
  description String?

  /// Nesting, so "claims → motor claims" is expressible. Null at the top.
  parentId String?
  parent   KnowledgeCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children KnowledgeCategory[] @relation("CategoryTree")

  /// Which insurance domain this maps to, when it maps to one. Lets the router
  /// send a motor question to motor guidance without a keyword list.
  domain String? // motor | health | life | travel | property | commercial

  /// Display order in an admin list. Alphabetical is rarely the useful order.
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  articles KnowledgeArticle[]

  @@index([parentId])
  @@index([domain])
  @@index([isActive, position])
}

/// A tag, normalised.
///
/// `KnowledgeArticle.tags` remains a comma-separated string and is still what
/// the existing employee search reads — it is not removed, because removing it
/// would break a working screen for no user-visible gain. This table is the
/// queryable form: "every article tagged cashless" is a join here and a full
/// scan there.
model KnowledgeTag {
  id   String @id @default(uuid())
  slug String @unique
  name String

  /// Denormalised count, so a tag cloud does not aggregate on every render.
  usageCount Int @default(0)

  createdAt DateTime @default(now())

  articles KnowledgeArticleTag[]

  @@index([usageCount])
}

model KnowledgeArticleTag {
  articleId String
  tagId     String

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     KnowledgeTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

/// An explicit grant on a RESTRICTED article.
///
/// Only consulted for RESTRICTED classification. PUBLIC and INTERNAL are
/// decided by realm and permission, because requiring a grant row per person
/// per article for ordinary guidance would mean nobody could read anything.
///
/// A grant is to a role or a person, never to "everyone" — a wildcard here
/// would quietly turn a restricted compliance document into an internal one.
model KnowledgePermission {
  id        String @id @default(uuid())
  articleId String

  /// Exactly one of these is set; the service enforces that.
  granteeUserId String?
  granteeRole   String?

  /// READ | WRITE | APPROVE
  access String @default("READ")

  grantedById String?
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, revokedAt])
  @@index([granteeUserId])
  @@index([granteeRole])
}

/// The inverted index lexical search reads.
///
/// Built on approval rather than at query time. Without it every search is a
/// `LIKE %term%` across article bodies, which is a full scan that gets slower
/// with exactly the thing the platform wants more of — content. With it, a
/// search is an indexed lookup per term.
///
/// Rebuilt wholesale for an article when it is approved, because incremental
/// index maintenance is where search engines grow their subtlest bugs.
model SearchIndexEntry {
  id String @id @default(uuid())

  /// The normalised term. Lower-cased, punctuation stripped, stemmed crudely.
  term String

  /// What it points at. `entityKind` so memory or documents could be indexed
  /// later without a second table.
  entityKind String // knowledgeArticle
  entityId   String

  /// Occurrences, used for term-frequency scoring.
  frequency Int    @default(1)
  /// Where it appeared — title matches count for more than body matches.
  field     String @default("body") // title | summary | body | tag

  createdAt DateTime @default(now())

  @@unique([term, entityKind, entityId, field])
  @@index([term])
  @@index([entityKind, entityId])
}

// ── Session memory ───────────────────────────────────────────────────────────

/// A conversation's working memory, on the platform side.
///
/// **This is not the agents' memory.** `ai-python/app/memory` and
/// `Aegis-AI/layer3` hold each agent's own namespaced state, and that isolation
/// is the architecture's crown jewel — nothing here reads or writes it.
///
/// What this holds is the memory the *platform's* services need across a
/// conversation: what has been established, what is pending, what the assistant
/// should not ask twice. It is durable, auditable and expires; an agent's
/// working memory is none of those things by design.
model ConversationMemory {
  id String @id @default(uuid())

  /// The thread this belongs to. A Sprint 10 conversation, or an AI session id.
  sessionRef String
  /// Whose conversation. Null for internal or system sessions.
  userId     String?

  /// SUMMARY | ESTABLISHED_FACT | OPEN_QUESTION | INTENT | HANDOFF_NOTE
  kind String

  /// Short label so a list is readable without opening each row.
  label String
  /// JSON payload.
  value String

  /// Pinned entries survive expiry and summarisation. Used for the two or three
  /// things that must not be forgotten mid-conversation — a stated budget, a
  /// disclosed condition.
  pinned Boolean @default(false)

  /// TEMPORARY memory is swept; SESSION lasts the conversation; PROMOTED has
  /// been written through to institutional memory and is kept for provenance.
  retention String @default("SESSION") // TEMPORARY | SESSION | PROMOTED

  /// Set when this was promoted into MemoryRecord, so the two can be reconciled.
  promotedRecordId String?

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([sessionRef, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([sessionRef, pinned])
}
