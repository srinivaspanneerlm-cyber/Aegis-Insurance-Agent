// ─────────────────────────────────────────────────────────────────────────────
// Aegis AI — Enterprise Insurance Platform : Prisma schema
//
// Design rules (enforced):
//   • Additive & backward-compatible — no existing field is renamed or dropped,
//     so the Prisma Client API used across the backend keeps working unchanged.
//   • Every model carries audit + soft-delete + optimistic-locking fields.
//   • Indexes cover every real query path (owner + time, status + time, FKs).
//   • Provider-portable MODELS: this schema validates on both SQLite (dev) and
//     PostgreSQL (prod). The `provider` below is a literal (Prisma can't read it
//     from env), so switch it with `npm run db:provider postgresql` at deploy;
//     migration SQL is dialect-specific and is regenerated per DB — see DATABASE.md.
//   • SQLite has no native enums; string fields document their allowed values.
//
// NOTE on soft delete: `deletedAt` is present on all core models but is NOT yet
// enforced in queries (that would change response behaviour). Enforcement is a
// deliberate, separately-reviewed follow-up so this change stays behaviour-safe.
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Core identity ────────────────────────────────────────────────────────────

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  // ── Identity: realm and role ───────────────────────────────────────────────
  // Two fields because they answer two different questions, and conflating them
  // is what produced three disagreeing role vocabularies in this codebase.
  //
  //   `realm` decides which portal a person enters. It is a property of who they
  //   are to the business — a customer, a member of branch staff, an enterprise
  //   administrator, an Aegis operator — and it changes almost never.
  //
  //   `role` is a named bundle of capabilities *within* a realm. It changes when
  //   someone's job changes, and new ones are expected.
  //
  // Neither is ever branched on directly. Authorisation asks for a permission;
  // the bundles live in `src/auth/permissions.ts` where a typo is a compile
  // error rather than a silently missing capability. See `src/auth/realms.ts`.
  realm String @default("CUSTOMER") // CUSTOMER | EMPLOYEE | ENTERPRISE | PLATFORM
  role  String @default("CUSTOMER") // CUSTOMER | EMPLOYEE | ENTERPRISE_ADMIN | PLATFORM_ADMIN | …

  isActive Boolean @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  version   Int       @default(1) // optimistic-locking token

  // ── Identity provider ──────────────────────────────────────────────────────
  // DEPRECATED: superseded by `LinkedIdentity`. One column can only ever hold
  // one provider, so a second way in (Microsoft, Apple, an insurer's OIDC, an
  // Aadhaar broker) would have meant a second column and a second code path.
  // Existing values were copied into LinkedIdentity by the migration that added
  // it; the column is kept because this schema never drops a field, but nothing
  // reads or writes it any more.
  googleId    String?   @unique
  image       String? // profile picture URL from the provider
  lastLoginAt DateTime?

  // ── Credential state ───────────────────────────────────────────────────────
  // Null means the address has never been proved. Whether that *blocks* sign-in
  // is a policy decision per realm, not a property of the column — see
  // `realms.ts`. A timestamp rather than a boolean because "when" is free to
  // store and answers questions a flag cannot.
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?

  // Lockout. Counted rather than inferred, so the threshold is auditable and a
  // successful sign-in can reset it in one write.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Future MFA. Present now so enrolling a factor is a data change rather than
  // a migration on a table that by then holds every account on the platform.
  mfaEnrolledAt DateTime?
  mfaMethod     String? // totp | webauthn | sms

  // ── Onboarding ─────────────────────────────────────────────────────────────
  // `onboardedAt` is the first-login gate: null means the conversational
  // onboarding has not been completed, so the user is sent there instead of the
  // dashboard. A timestamp rather than a boolean — "when" is free to store and
  // answers questions a flag cannot.
  onboardedAt       DateTime?
  preferredLanguage String? // en | ta | taEn
  // JSON array of interest ids. SQLite has no list type and this schema targets
  // both SQLite (dev) and Postgres (prod), so it is stored the same way
  // AuditLog.metadata is.
  insuranceInterests String?

  // Relations (all nullable on the owned side to preserve legacy rows)
  chats             Chat[]
  uploadedDocuments UploadedDocument[]
  leads             Lead[]                  @relation("AssignedLeads")
  sessions          Session[]
  recommendations   RecommendationHistory[]
  notifications     Notification[]
  auditLogs         AuditLog[]              @relation("ActorAuditLogs")
  refreshTokens      RefreshToken[]
  linkedIdentities   LinkedIdentity[]
  authSessions       AuthSession[]
  verificationTokens VerificationToken[]
  loginEvents        LoginEvent[]

  @@index([realm])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
}

// ── Auth: external identities ────────────────────────────────────────────────
// One row per way a person can prove who they are. Many per user, because the
// same customer may sign in with Google on their phone and with an insurer's
// OIDC at a branch, and both have to land on the same account.
//
// The pair (provider, subject) is the durable link — an email address is not,
// because people change theirs, and matching on one is only safe when the
// provider has told us it is verified.
model LinkedIdentity {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String // google | microsoft | apple | oidc:<issuer> | …
  subject  String // the provider's own stable id for this person

  // What the provider said at link time. Kept for support ("which account is
  // this?") and never used for matching — `subject` is the identity.
  email    String?
  linkedAt DateTime  @default(now())
  lastUsed DateTime?

  // One account per external identity. This is the constraint that stops two
  // Aegis users from claiming the same Google account.
  @@unique([provider, subject])
  @@index([userId])
}

// ── Auth: rotating refresh tokens (durable session revocation) ───────────────
// Only the SHA-256 hash of the opaque refresh token is stored (never the raw
// value). Rotation revokes the old row and inserts a new one; logout revokes.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // The sitting this credential belongs to. Nullable because tokens issued
  // before sessions existed have no sitting to point at, and inventing one for
  // them would put a fiction in the audit trail.
  sessionId String?
  session   AuthSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([sessionId])
}

// ── Identity: sittings ───────────────────────────────────────────────────────
// One row per "somebody signed in here, on this device, at this time".
//
// Deliberately NOT named `Session` — that name is already the AI conversation
// session further down this file, and two different things called Session in
// one schema is a defect waiting to be written. This is the *authentication*
// sitting; a refresh token is the credential that keeps it alive.
//
// Its reason for existing is that "sign me out everywhere" and "what is signed
// in to my account right now" are questions a bag of refresh tokens cannot
// answer legibly.
model AuthSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Copied at creation rather than read through to the user, because the answer
  // to "which portal was this sitting for" must not change retroactively when
  // somebody's realm is changed.
  realm String

  ipAddress String?
  userAgent String?

  // Future device trust. A remembered device can skip a second factor, which is
  // only safe once there is something durable to remember it by.
  deviceId    String?
  deviceLabel String?
  trustedAt   DateTime?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  // Why it ended: LOGOUT | LOGOUT_ALL | REPLAY | IDLE | ADMIN | EXPIRED
  revokedReason String?

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([userId, lastSeenAt])
}

// ── Identity: one-time proofs ────────────────────────────────────────────────
// Email verification and password reset are the same mechanism with different
// consequences, so they are one table with a `purpose` rather than two tables
// that would drift apart on expiry, single-use and hashing.
//
// Only the SHA-256 hash is stored. A reset table readable from a database dump
// is a table of live account takeovers.
model VerificationToken {
  id        String @id @default(uuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose String // EMAIL_VERIFICATION | PASSWORD_RESET

  // Bound to the address it was issued for. A reset link must stop working if
  // the account's email changes between issue and use.
  email String

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// ── Identity: login history ──────────────────────────────────────────────────
// Every attempt, successful or not. Separate from AuditLog because this is the
// one trail a *customer* is entitled to read about their own account, and
// mixing it into the platform's audit stream would make that impossible to
// serve without leaking everything else.
//
// `email` is stored alongside `userId` because the interesting failures are the
// ones where no user was found.
model LoginEvent {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email String
  // SUCCESS | BAD_CREDENTIALS | NO_ACCOUNT | LOCKED | INACTIVE | UNVERIFIED
  // | WRONG_REALM | PROVIDER_REJECTED
  outcome String
  // PASSWORD | google | microsoft | apple | …
  method String
  realm  String?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([createdAt])
}

// ── Catalogue: companies & policies ──────────────────────────────────────────

model Company {
  id          String    @id @default(uuid())
  companyName String
  logo        String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)

  policies Policy[]

  @@index([companyName])
  @@index([deletedAt])
  // getCompanies lists all companies ordered by createdAt.
  @@index([createdAt])
}

model Policy {
  id         String    @id @default(uuid())
  policyName String
  premium    Float
  coverage   String
  companyId  String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime?
  version    Int       @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([policyName])
  @@index([deletedAt])
}

// ── Sales pipeline: leads ────────────────────────────────────────────────────

model Lead {
  id            String    @id @default(uuid())
  customerName  String
  email         String
  phone         String
  insuranceType String
  budget        String
  status        String    @default("pending") // pending | contacted | qualified | won | lost
  assignedToId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?
  version       Int       @default(1)

  assignedTo User? @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@index([assignedToId])
  @@index([deletedAt])
  // Unfiltered admin list (getLeads) sorts by createdAt with no status filter,
  // which the leading-column [status, createdAt] index cannot serve.
  @@index([createdAt])
}

// ── Conversations ────────────────────────────────────────────────────────────

model Chat {
  id          String    @id @default(uuid())
  message     String
  sender      String // customer | advisor
  sessionId   String?
  userId      String?
  agentName   String?
  agentDomain String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([agentDomain])
  @@index([deletedAt])
}

// ── Documents ────────────────────────────────────────────────────────────────

model UploadedDocument {
  id         String    @id @default(uuid())
  filename   String
  filepath   String
  ownerId     String? // scopes documents to their uploader (closes the upload IDOR)
  mimeType    String?
  sizeBytes   Int?
  contentHash String? // SHA-256 of the file bytes — used for duplicate detection
  uploadedAt  DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([deletedAt])
  // Admin document listing (getUploadedDocuments) sorts all rows by uploadedAt.
  @@index([uploadedAt])
  // Duplicate detection: look up a prior upload by the same owner + content hash.
  @@index([ownerId, contentHash])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI-platform tables — PREPARED for the multi-agent engine, recommendation
// history, transfers, notifications and audit. These are additive and not yet
// wired into the (currently file-backed) AI memory, so no AI workflow changes.
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id          String    @id @default(uuid())
  sessionId   String    @unique // external session id used by the AI engine
  userId      String?
  agentDomain String? // health | motor | travel | home-property | executive
  agentName   String?
  status      String    @default("active") // active | transferred | closed
  startedAt   DateTime  @default(now())
  lastActive  DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  user            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  chats           Chat[]
  recommendations RecommendationHistory[]
  transfers       AgentTransfer[]

  @@index([userId, lastActive])
  @@index([status])
  @@index([agentDomain])
}

model RecommendationHistory {
  id          String   @id @default(uuid())
  userId      String?
  sessionId   String?
  domain      String // health | motor | travel | home-property
  planName    String?
  score       Float?
  confidence  Float?
  approval    String? // Approved | Pending | Rejected
  profileHash String? // ties a recommendation to the profile snapshot it was built from
  payload     String? // JSON blob of the full recommendation
  createdAt   DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([domain])
  @@index([profileHash])
}

model AgentTransfer {
  id         String   @id @default(uuid())
  sessionId  String?
  fromDomain String?
  toDomain   String?
  fromAgent  String?
  toAgent    String?
  reason     String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  session Session? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([toDomain])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // system | underwriting | claim | renewal | payment
  title     String
  body      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([type])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String? // the user who performed the action (null = system)
  action    String // e.g. auth.login, lead.update, policy.create
  entity    String? // model name
  entityId  String? // affected row id
  metadata  String? // JSON blob of contextual detail (never store secrets/PII in clear)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}
