# ─────────────────────────────────────────────────────────────
# Aegis AI Engine (FastAPI) — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Service network
PORT=8000
HOST=0.0.0.0

# Deployment environment — controls docs exposure & CORS strictness
ENVIRONMENT=development               # development | production

# LLM provider selection: ollama | gemini | openai
DEFAULT_PROVIDER=ollama

# Who answers when the provider above cannot — tried in this order, and any
# provider without credentials is skipped. The fallback receives the same
# system prompt and conversation history, so the customer's turn is answered
# and the conversation continues; nothing about the switch is visible to them.
LLM_FALLBACK_PROVIDERS="gemini,openai"

# Seconds one provider gets for a whole turn before the next one is asked.
# Only applies while another provider is still queued behind it.
LLM_PROVIDER_BUDGET_SECONDS=18

# Provider credentials (set at least one). NEVER commit real keys.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Gemini model names. Kept in config because Google retires models: a name
# hardcoded in source starts 404-ing for newly issued keys with no warning.
# Check `genai.list_models()` if a call returns "no longer available".
GEMINI_MODEL="gemini-3.5-flash"
# Embedding model for the semantic half of knowledge retrieval.
# Empty = keyword-only search (the same path taken with no Gemini key).
GEMINI_EMBEDDING_MODEL="models/gemini-embedding-001"

# ── Speech-to-text ───────────────────────────────────────────────────────────
# Who transcribes a spoken turn. Named here and nowhere else in the codebase —
# no route, controller or component mentions a vendor — so moving to Whisper or
# Groq is this line plus a class in app/services/stt_service.py.
STT_PROVIDER="gemini"
# The transcription model. Empty = reuse GEMINI_MODEL, so a deployment with
# Gemini working for chat has voice working too, with nothing extra to set.
STT_MODEL=""
# Caps on one recording. ~8 MB is minutes of Opus; below 1200 bytes there is a
# container header and no speech, and an empty upload must never buy a paid call.
STT_MAX_BYTES="8388608"
STT_MIN_BYTES="1200"
# The customer waits in silence for this, so it is tighter than the chat timeout.
STT_TIMEOUT_SECONDS="20"

# Ollama (local or cloud). For Ollama Cloud use base_url https://ollama.com
# and set OLLAMA_API_KEY to your ollama.com key.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gpt-oss:20b"
OLLAMA_API_KEY="ollama"

# Storage
CHROMA_DB_PATH="./chroma"
UPLOADS_DIR="uploads"

# Comma-separated browser/service origins allowed by CORS.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000"

# Shared secret to authenticate calls from the Node backend.
# When set, requests without a matching X-Internal-Api-Key header are rejected.
# Must match backend's AI_INTERNAL_API_KEY.
AI_INTERNAL_API_KEY=""
