# ─────────────────────────────────────────────────────────────
# Aegis AI Engine (FastAPI) — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Service network
PORT=8000
HOST=0.0.0.0

# Deployment environment — controls docs exposure & CORS strictness
ENVIRONMENT=development               # development | production

# LLM provider selection: ollama | gemini | openai
DEFAULT_PROVIDER=ollama

# Provider credentials (set at least one). NEVER commit real keys.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Ollama (local or cloud). For Ollama Cloud use base_url https://ollama.com
# and set OLLAMA_API_KEY to your ollama.com key.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gpt-oss:20b"
OLLAMA_API_KEY="ollama"

# Storage
CHROMA_DB_PATH="./chroma"
UPLOADS_DIR="uploads"

# Comma-separated browser/service origins allowed by CORS.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000"

# Shared secret to authenticate calls from the Node backend.
# When set, requests without a matching X-Internal-Api-Key header are rejected.
# Must match backend's AI_INTERNAL_API_KEY.
AI_INTERNAL_API_KEY=""
