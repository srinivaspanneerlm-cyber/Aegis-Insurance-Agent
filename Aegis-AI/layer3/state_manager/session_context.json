{
  "version": "1.0",
  "session_parameters": {
    "session_id": {
      "type": "string",
      "required": true
    },
    "start_time": {
      "type": "string",
      "required": true
    },
    "active_category": {
      "type": "string",
      "enum": ["health", "motor", "travel", "home-property", "miscellaneous", "none"],
      "default": "none"
    },
    "last_user_message": {
      "type": "string",
      "default": ""
    },
    "turn_count": {
      "type": "integer",
      "default": 0
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  }
}
