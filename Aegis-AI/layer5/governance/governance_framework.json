{
    "version": "5.0",
    "governance_model": {
        "name": "Sri AI Executive Governance Framework",
        "authority": "Enterprise Wide"
    },
    "governance_hierarchy": {
        "layer1": {
            "responsibility": "Knowledge Validation"
        },
        "layer2": {
            "responsibility": "Routing Validation"
        },
        "layer3": {
            "responsibility": "Profile Validation"
        },
        "layer4": {
            "responsibility": "Recommendation Validation"
        },
        "layer5": {
            "responsibility": "Executive Governance"
        }
