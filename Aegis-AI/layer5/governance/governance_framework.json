        "can_reject": true,
        "can_override": true,
        "can_escalate": true,
        "can_request_reassessment": true
    },
    "strategic_objectives": [
        "maximize_customer_trust",
        "maximize_recommendation_accuracy",
        "maximize_customer_protection",
        "maintain_enterprise_governance",
        "maintain_long_term_customer_value"
