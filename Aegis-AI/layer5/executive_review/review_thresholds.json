            "score": 74,
            "action": "reject"
        }
    },
    "confidence_thresholds": {
        "excellent": 95,
        "good": 90,
        "acceptable": 85,
        "minimum": 80
    },
    "customer_profile_thresholds": {
        "minimum_completion_percentage": 80,
        "minimum_required_fields": [
            "age",
            "family_size",
            "budget"
        ]
    }
