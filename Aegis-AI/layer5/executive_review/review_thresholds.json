{
    "version": "5.0",
    "recommendation_thresholds": {
        "executive_excellence": {
            "score": 95,
            "action": "auto_approve"
        },
        "enterprise_standard": {
            "score": 90,
            "action": "approve"
        },
        "acceptable": {
            "score": 85,
            "action": "review_required"
        },
        "below_standard": {
