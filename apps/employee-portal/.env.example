# @aegis/employee-portal
# Copy to `.env.local`. Never commit a filled-in copy.

# ── Public — inlined into the browser bundle. Nothing secret may ever live here.

# The API. Must be the same origin the identity platform minted the session
# against, or the httpOnly cookie is not sent and every request is silently
# anonymous.
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Where a signed-out or wrong-realm arrival is sent. This portal never renders
# its own sign-in screen — authentication is the identity platform's job, and a
# second login form here would be a second thing to keep secure.
NEXT_PUBLIC_IDENTITY_URL="http://localhost:3105"

NEXT_PUBLIC_ENVIRONMENT="development"

# ── The API's own settings (set these on the backend, not here) ──────────────
#
#   CLIENT_URL   must include http://localhost:3102 — it is the CSRF allowlist,
#                and every POST from this portal is refused without it.
