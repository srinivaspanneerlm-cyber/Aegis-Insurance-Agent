# @aegis/customer-portal
# Copy to `.env.local`. Never commit a filled-in copy.

# Public — inlined into the browser bundle. Nothing secret may ever live here.
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
NEXT_PUBLIC_ENVIRONMENT="development"

# Server-only. Readable in server components and route handlers, never shipped
# to the browser.
# SESSION_SECRET=""
