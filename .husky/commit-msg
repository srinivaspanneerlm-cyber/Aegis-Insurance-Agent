#!/usr/bin/env sh

# Conventional Commits, checked with one regular expression rather than a
# dependency.
#
# The subject line is what future engineers read in `git log` when they are
# trying to understand why something is the way it is — the charter asks that
# the body explain *why*, and this keeps the first line scannable enough for
# that to be worth reading.
#
# Merge and revert commits are generated by git itself and are left alone.

commit_message_file="$1"
first_line=$(head -n 1 "$commit_message_file")

case "$first_line" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "✗ Commit message does not follow Conventional Commits."
  echo ""
  echo "  Got:      $first_line"
  echo "  Expected: <type>(<optional scope>): <subject, max 72 chars>"
  echo ""
  echo "  Types:    feat fix docs style refactor perf test build ci chore revert"
  echo "  Example:  feat(auth): separate staff sessions from customer sessions"
  echo ""
  exit 1
fi
