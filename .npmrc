# Hoisting is off by default in pnpm, which is the point: a package can only
# import what it actually declares. That is what stops `apps/website` from
# quietly compiling against a dependency it never asked for and then breaking
# the day another app drops it.
strict-peer-dependencies=false
auto-install-peers=true

# Next.js and its plugins resolve a few packages from the app root rather than
# through the importer, so those need to be flat.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*types*
