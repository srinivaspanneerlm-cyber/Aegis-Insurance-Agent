# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Brand assets: the 4096px renders are build output, not source. They are 18 MB
# and regenerate in ~30s from the committed geometry:
#   node scripts/build-brand-assets.mjs
# Everything else in public/brand IS committed, so a clone needs no build step
# for normal use. The SVGs are infinitely scalable regardless.
public/brand/**/*-4096.png
