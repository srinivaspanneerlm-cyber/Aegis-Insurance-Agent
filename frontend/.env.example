# ─────────────────────────────────────────────────────────────
# Aegis AI Frontend (Next.js) — environment template
# Copy to `.env.local`. Only NEXT_PUBLIC_* vars are exposed to the browser,
# so never put secrets here.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Google Sign-In — OAuth 2.0 Web client ID (from Google Cloud Console). Public
# by design (embedded in the browser); must match the backend's GOOGLE_CLIENT_ID.
# When empty, the login page hides the Google button and email/password is used.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Core Web Vitals sink. When set, the app beacons LCP/INP/CLS/etc. to this URL
# via navigator.sendBeacon (fire-and-forget). When empty, vitals are only logged
# locally (quiet in production) — no telemetry network calls are made.
NEXT_PUBLIC_WEBVITALS_URL=""

# Who transcribes a spoken turn. "server" (the default) posts the recording to
# the backend, which is the only setting that works in every browser — Firefox
# and Safari have no SpeechRecognition, and Brave's is present but permanently
# broken by design. Set to "browser" to restore the old Chrome-only path, which
# is worth doing only where no STT provider is configured on the AI engine.
NEXT_PUBLIC_VOICE_TRANSCRIPTION="server"
