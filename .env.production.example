# ═════════════════════════════════════════════════════════════════════════════
# Aegis AI — PRODUCTION environment (docker-compose.prod.yml)
#
# Copy to `.env.production` (gitignored) and fill in real values. This file is
# the SINGLE secret source for the prod stack; compose injects it into the
# backend + AI containers. NEVER commit `.env.production`, and never bake these
# into an image.
# ═════════════════════════════════════════════════════════════════════════════

# ── Public URLs ──────────────────────────────────────────────────────────────
# Browser origin(s) allowed by CORS (comma-separated, no trailing slash).
CLIENT_URL=https://app.example.com
# API base baked into the frontend bundle at BUILD time. Behind nginx (Step 3)
# this becomes "/api"; without a proxy, point it at the backend's public URL.
NEXT_PUBLIC_API_URL=https://app.example.com/api

# ── Secrets (generate high-entropy values) ───────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Shared backend<->AI secret; MUST be identical on both services.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_INTERNAL_API_KEY=

# ── Auth / proxy behaviour ───────────────────────────────────────────────────
COOKIE_SECURE=true          # served over HTTPS in prod
TRUST_PROXY=1               # number of proxies in front (nginx = 1)
JWT_EXPIRES_IN=30d

# ── Database ─────────────────────────────────────────────────────────────────
# DEFAULT: SQLite on a persistent named volume (matches the current Prisma
# provider). To use PostgreSQL instead, enable the `postgres` compose profile
# AND switch the Prisma datasource provider to "postgresql" + run
# `prisma migrate deploy` (see DATABASE.md — this is a reviewed DB migration).
DATABASE_URL=file:/data/prod.db
# Used only when the postgres profile is enabled:
POSTGRES_USER=aegis
POSTGRES_PASSWORD=
POSTGRES_DB=aegis
# DATABASE_URL for postgres profile:
#   postgresql://aegis:<password>@postgres:5432/aegis?schema=public

# ── Cache / scale-out ────────────────────────────────────────────────────────
# Compose provides a redis service on the internal network.
REDIS_URL=redis://redis:6379

# ── AI engine (LLM provider) ─────────────────────────────────────────────────
ENVIRONMENT=production
DEFAULT_PROVIDER=gemini      # ollama | gemini | openai
GEMINI_API_KEY=
OPENAI_API_KEY=
# Origins the AI engine accepts (usually just the backend service URL).
ALLOWED_ORIGINS=http://backend:5000
# Workers for the AI engine. Keep 1 until the file-based Layer-3 memory is made
# process-safe (multiple workers would race the on-disk profile/conversation store).
WEB_CONCURRENCY=1
