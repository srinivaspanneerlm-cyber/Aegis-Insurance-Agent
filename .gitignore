# ─────────────────────────────────────────────────────────────
# Aegis AI — root ignore rules (security & hygiene)
# ─────────────────────────────────────────────────────────────

# Secrets & environment files — NEVER commit real credentials
.env
.env.*
!.env.example
!.env.production.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Node
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js / frontend build output
.next/
**/.next/
out/
build/
dist/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
**/venv/
.pytest_cache/

# Databases / local data (never ship a checked-in DB)
*.db
*.sqlite
*.sqlite3
backend/prisma/dev.db
# SQLite sidecar/transient files (contain uncommitted DB data)
*.db-journal
*.db-wal
*.db-shm
# DB backups / snapshots (contain real user data — keep out of git)
*.db.bak-*
*.db.backup
*.bak-roles-*

# Uploaded user content
backend/src/uploads/*
!backend/src/uploads/.gitkeep

# Logs
*.log
logs/

# Editor / OS
.DS_Store
Thumbs.db

# ── Layer 3 runtime memory — real customers' data ────────────────────────────
# The AI engine writes a profile, a conversation state, a risk score and a
# recommendation cache entry per customer into these directories as it runs. In
# production each of those describes a real person: their name, age, income,
# medical history, and what they told an advisor. None of it belongs in git.
#
# Nothing here is a required fixture — the engine creates each file on demand
# when it is missing. The demo personas below are checked in deliberately and
# carry sample data only; anything else that appears here is a real customer.
#
# (state_manager/ is NOT ignored: those files are schema definitions, not data.)

Aegis-AI/layer3/customer_profile/customer_profiles/*
!Aegis-AI/layer3/customer_profile/customer_profiles/cust_john.json
!Aegis-AI/layer3/customer_profile/customer_profiles/cust_officer_bob.json
!Aegis-AI/layer3/customer_profile/customer_profiles/cust_raja.json
!Aegis-AI/layer3/customer_profile/customer_profiles/cust_sri.json
!Aegis-AI/layer3/customer_profile/customer_profiles/executive_cust_sri.json
!Aegis-AI/layer3/customer_profile/customer_profiles/shared_cust_sri.json

Aegis-AI/layer3/conversation_memory/conversations/*
!Aegis-AI/layer3/conversation_memory/conversations/cust_john_state.json
!Aegis-AI/layer3/conversation_memory/conversations/cust_officer_bob_state.json
!Aegis-AI/layer3/conversation_memory/conversations/cust_raja_state.json
!Aegis-AI/layer3/conversation_memory/conversations/cust_sri_state.json

Aegis-AI/layer3/customer_intelligence/intelligence_profiles/*
!Aegis-AI/layer3/customer_intelligence/intelligence_profiles/cust_john.json
!Aegis-AI/layer3/customer_intelligence/intelligence_profiles/cust_officer_bob.json
!Aegis-AI/layer3/customer_intelligence/intelligence_profiles/cust_sri.json

Aegis-AI/layer3/recommendation_context/cache/*
!Aegis-AI/layer3/recommendation_context/cache/executive_cust_sri_rec.json

Aegis-AI/layer3/conversation_memory/sessions/

# Local backup archives (never commit)
/backups/
backups/

# ── Monorepo (apps/ packages/ services/) ─────────────────────────────────────
# pnpm store and per-app Next output. `dist/`, `build/`, `.next/` and
# `node_modules/` are already covered above.
.pnpm-store/
apps/*/.next/
apps/*/next-env.d.ts
*.tsbuildinfo

# End-to-end runs build here so they cannot disturb a dev server
.next-e2e/
e2e/.e2e-db
test-results/
playwright-report/

# Advisor-memory snapshots taken by scripts/reset-demo-memory.sh before a
# rehearsal. Local working state, and they contain customer conversation data.
.demo-memory-backups/
