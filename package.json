{
  "name": "@aegis/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Aegis AI — enterprise monorepo foundation",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "pnpm -r --no-bail lint",
    "format": "prettier --write \"{apps,packages,services}/**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"{apps,packages,services}/**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "clean": "pnpm -r exec rm -rf .next dist node_modules/.cache",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@aegis/eslint-config": "workspace:*",
    "@aegis/tsconfig": "workspace:*",
    "@playwright/test": "1.62.1",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.2"
  }
}
